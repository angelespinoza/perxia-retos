# Proveedor del modelo: anthropic | openai | gemini
LLM_PROVIDER=anthropic
# Modelo del proveedor elegido (anthropic usa claude-opus-5-5 si se deja vacío)
LLM_MODEL=
# Solo hace falta la clave del proveedor activo
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Esfuerzo de razonamiento (Anthropic): low | medium | high
LLM_EFFORT=medium
LLM_TIMEOUT_MS=60000
# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
# Carpeta de salida local (por defecto ./out)
OUT_DIR=
# Solo en Vercel: token del Blob store privado (lo inyecta Vercel al conectar el store)
BLOB_READ_WRITE_TOKEN=
# Opcional: clave para proteger el link público
ACCESS_KEY=
PORT=3000

# Proveedor del modelo: anthropic | openai | gemini
LLM_PROVIDER=anthropic
# Modelo del proveedor elegido (anthropic usa claude-opus-5-5 si se deja vacío)
LLM_MODEL=
# Solo hace falta la clave del proveedor activo
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Esfuerzo de razonamiento (Anthropic): low | medium | high
LLM_EFFORT=medium
LLM_TIMEOUT_MS=60000
# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
# Carpeta de salida local (por defecto ./out)
OUT_DIR=
# Solo en Vercel: token del Blob store privado (lo inyecta Vercel al conectar el store)
BLOB_READ_WRITE_TOKEN=
# Ingreso por /login (obligatorio: sin estas tres variables nadie puede entrar).
# Se cargan en Vercel como variables sensibles; nunca en el repositorio.
APP_USER=
APP_PASSWORD=
# Al menos 16 caracteres aleatorios, por ejemplo: openssl rand -base64 32
SESSION_SECRET=
PORT=3000
